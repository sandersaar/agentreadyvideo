{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentreadyvideo.org/schema/1.0/playback-descriptor.schema.json",
  "title": "ARV PlaybackDescriptor",
  "description": "Player-neutral playback for one moment. Returned only by a playback call, never by discovery. A signed URL MUST NOT appear in any cached or crawlable response.",
  "type": "object",
  "required": [
    "arv",
    "moment_uri",
    "start_ms",
    "sources"
  ],
  "properties": {
    "arv": {
      "const": "1.0",
      "description": "ARV version. Every ARV object carries \"arv\": \"1.0\"."
    },
    "moment_uri": {
      "type": "string",
      "pattern": "^arv:[^#\\s]+#t=\\d+,\\d+$",
      "description": "arv:{asset_id}#t={start_ms},{end_ms}. The canonical snapped range is the moment's identity."
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Where the player starts."
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Advisory only. The moment's end, carried for rights and receipts. Players MUST NOT stop at end_ms; playback continues past the moment."
    },
    "cue_points": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "More start times in milliseconds, for a multi-step answer."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "provider"
        ],
        "properties": {
          "kind": {
            "enum": [
              "hls",
              "dash",
              "mp4",
              "embed"
            ]
          },
          "provider": {
            "type": "string"
          },
          "token_ref": {
            "type": "string",
            "description": "Exchanged at the origin for a short-lived URL."
          },
          "embed_url": {
            "type": "string",
            "format": "uri"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "start_param": {
            "type": "string"
          }
        }
      }
    },
    "poster": {
      "type": "string",
      "format": "uri"
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lang",
          "url"
        ],
        "properties": {
          "lang": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "token": {
      "type": "object",
      "required": [
        "ref",
        "jws_kid",
        "expires_at",
        "scope"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "jws_kid": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "entitlement": {
      "type": "object",
      "description": "Entitlement needed to use this moment. Defined in 1.0, implementation optional. A conforming L3 origin that sets required=true must also return 402 or 403 with the challenge_url when a token is requested without it.",
      "required": [
        "required",
        "kind"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "none",
            "account_link",
            "subscription",
            "purchase"
          ]
        },
        "link_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "https URL where the user links an account or buys."
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "payment": {
      "type": "object",
      "description": "Payment needed to use this moment. Defined in 1.0, implementation optional. A conforming L3 origin that sets required=true must also return 402 or 403 with the challenge_url when a token is requested without it.",
      "required": [
        "required",
        "model"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "model": {
          "enum": [
            "free",
            "per_use",
            "per_view",
            "subscription"
          ]
        },
        "amount": {
          "type": "object",
          "required": [
            "currency",
            "minor_units"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO 4217 currency code."
            },
            "minor_units": {
              "type": "integer",
              "minimum": 0,
              "description": "Amount in the currency's minor units, for example cents."
            }
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Payment methods the origin accepts, for example \"http-402\", \"stripe-agentic\", \"ap2\", \"wallet\"."
        },
        "challenge_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "https URL of the payment challenge."
        }
      }
    }
  },
  "additionalProperties": true
}
